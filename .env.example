# =============================================================================
# Abstraxn Agent Kit
# Get ABSTRAXN_API_KEY from Dashboard → Agentic Stack → Overview
# =============================================================================
ABSTRAXN_API_KEY=your_application_api_key
ABSTRAXN_AGENT_KIT_API_URL=https://agent-kit.abstraxn.com
ABSTRAXN_USER_IDENTITY=demo@example.com

# Optional: reuse an existing agent (skip create on boot)
# ABSTRAXN_AGENT_ID=
# ABSTRAXN_MCP_TOKEN=
# ABSTRAXN_EVM_ADDRESS=
# ABSTRAXN_ACCESS_KEY=
# ABSTRAXN_ORGANIZATION_ID=

# =============================================================================
# LLM — choose ONE provider block below (uncomment the one you use)
# =============================================================================

# --- OpenAI (default) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- OpenRouter (100+ models via one API key) ---
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-3.5-sonnet
# Base URL is automatic; override only if needed:
# LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Anthropic (direct) ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20241022

# --- Any OpenAI-compatible API (Groq, Together, local vLLM, etc.) ---
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=your_api_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Legacy names (still work): OPENAI_API_KEY, OPENAI_MODEL

# =============================================================================
# Swiggy food ordering (examples/05-swiggy-food-ordering only)
# OAuth 2.1 + PKCE against Swiggy's real endpoints is handled automatically
# in-app via the "Connect Swiggy Account" button — no env vars required.
# The two vars below are an OPTIONAL manual override/fallback, only used if
# no account has been connected through the in-app OAuth flow (e.g. if you
# already have a token pair from another source, like Claude.ai's Swiggy
# connector).
# =============================================================================
# SWIGGY_ACCESS_TOKEN=
# SWIGGY_REFRESH_TOKEN=

# =============================================================================
# OpenWeb Ninja x402 agent (examples/06-openweb-ninja-x402 only)
# Pays OpenWeb Ninja's tools directly in USDC on mainnet (Base/Polygon/Arbitrum) —
# no API key. Fund the agent's evmAddress (shown in the app) with a small amount of
# USDC before clicking "Pay & Retry". Optional RPC overrides (public defaults used
# otherwise):
# =============================================================================
# BASE_RPC_URL=https://mainnet.base.org
# POLYGON_RPC_URL=https://polygon-rpc.com
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# 05-crypto-market-data — x402 auto-pay signing
# cmc_* tools return a payment-required challenge instead of settling it server-side;
# this example signs it using the agent's own cached accessKey (see ABSTRAXN_ACCESS_KEY
# above) and retries. Requires the agent's own wallet to hold real USDC on Base mainnet —
# no sandbox exists for CoinMarketCap's x402 endpoint.
# =============================================================================
# CHAIN_RPC_BASE=https://base.publicnode.com
# X402_MAX_PAYMENT_USD=0.05

# =============================================================================
# 09-warrant-gated-transfer — KYI Warrant (required for this example)
# Runtime uses the per-mandate API key (not the application key).
# WARRANT_AGENT_ID must match the sealed mandate's agent_id.
# =============================================================================
WARRANT_URL=https://api-warrant.abstraxn.com
WARRANT_MANDATE_API_KEY=
WARRANT_AGENT_ID=agent_web3_demo

# =============================================================================
# 02-trading-agent — Coinbase BYOK (required for this example)
# web3-agent-kit-service holds no Coinbase key at all: every coinbase_* tool except
# coinbase_get_price requires a caller-minted bearer token. This backend mints one
# locally, per call, from these keys — the real key is never sent to Abstraxn. Without
# both vars set, this example's /api/chat returns a COINBASE_BYOK_NOT_CONFIGURED error.
# =============================================================================
# COINBASE_BYOK_API_KEY_NAME=organizations/.../apiKeys/...
# COINBASE_BYOK_API_KEY_SECRET=
